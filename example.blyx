use betaupdate;

fn main() {
    let alpha = 1.0;
    let beta = 1.0;
    let positive = 3.0;
    let negative = 1.0;
    let result = betaupdate_observe(alpha, beta, positive, negative);
    if len(result) == 0 { println!("invalid"); return; }
    let mut i = 0;
    while i < len(result) {
        println!(at(result, i));
        i += 1;
    }
}
